# ---------- LLM providers ----------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- Data providers ----------
TAVILY_API_KEY=
FRED_API_KEY=

# SEC EDGAR requires a descriptive User-Agent per their fair-use policy.
# Format: "Company or Project Name <contact@email>"
SEC_EDGAR_USER_AGENT="InvestABull Research <contact@example.com>"

# ---------- RAG / storage ----------
CHROMA_PERSIST_DIR=./.chroma
SEC_FILINGS_CACHE_DIR=./.sec_cache
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# When true, /research never ingests 10-Ks on demand (only queries Chroma).
# Pair with a scheduled job: `python -m app.rag.cli ingest AAPL MSFT ...`
# or POST /api/filings/ingest {"tickers": [...]}.
FILINGS_READ_ONLY=false

# ---------- Runtime ----------
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
