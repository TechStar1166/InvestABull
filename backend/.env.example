# ---------- LLM providers ----------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- Data providers ----------
TAVILY_API_KEY=
FRED_API_KEY=

# SEC EDGAR requires a descriptive User-Agent per their fair-use policy.
# Format: "Company or Project Name <contact@email>"
SEC_EDGAR_USER_AGENT="InvestABull Research <contact@example.com>"

# ---------- RAG / storage ----------
CHROMA_PERSIST_DIR=./.chroma
SEC_FILINGS_CACHE_DIR=./.sec_cache
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# When true, /research never ingests 10-Ks on demand (only queries Chroma).
# Pair with a scheduled job: `python -m app.rag.cli ingest AAPL MSFT ...`
# or POST /api/filings/ingest {"tickers": [...]}.
FILINGS_READ_ONLY=false

# ---------- News / Tavily speed tuning ----------
# 'basic' is ~2-3x faster than 'advanced' and usually fine for memo-level summaries.
TAVILY_SEARCH_DEPTH=basic
# Smaller = fewer tokens into the News LLM and fewer Tavily credits.
TAVILY_MAX_RESULTS=5
# Narrower windows return fresher, more signal-dense articles.
TAVILY_DAYS_BACK=7
# In-memory TTL cache for Tavily results (per process). 0 disables.
TAVILY_CACHE_TTL_SECONDS=600

# News LLM payload tuning (applied in run_news_specialist before calling Gemini)
NEWS_LLM_MAX_ARTICLES=5
NEWS_LLM_INCLUDE_SNIPPET=false
NEWS_LLM_SNIPPET_CHARS=300

# ---------- Macro / FRED speed tuning ----------
# Thread pool size for parallel FRED series fetches in fetch_macro_bundle.
# 1 = sequential (debug/test); 4 is a good default for the 7-series bundle.
FRED_MAX_WORKERS=4
# FRED data is daily/weekly/monthly, so a multi-hour cache is safe.
# 21600 = 6h. Set to 0 to disable.
FRED_BUNDLE_CACHE_TTL_SECONDS=21600
# Series metadata (title/units/frequency) basically never changes.
# 86400 = 24h.
FRED_SERIES_INFO_CACHE_TTL_SECONDS=86400

# ---------- Runtime ----------
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
